# Service Configuration
SERVICE_NAME=sales-service
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug

# Database Configuration — order_db (12 tablas de PLAT-E25)
# Rol de aplicación SIN DDL ni superuser (PLAT-E25 T3, RULE-09/RULE-10): el runtime NUNCA
# se conecta como postgres — un superuser bypasea RLS (rolbypassrls=t) y anula el
# aislamiento por tenant de las policies de 024_rls_sales_tables.up.sql. sales_app tiene
# SELECT/INSERT/UPDATE/DELETE sobre las 12 tablas de la épica, creado por
# migrations/025_create_app_role.up.sql (idempotente, corre junto al resto de migraciones).
# En producción: password fuerte vía secret, nunca en este archivo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sales_app
DB_PASSWORD=sales_app123
DB_NAME=order_db
DB_SSLMODE=disable

# payment_method_db — FUERA de scope de PLAT-E25 (ver Riesgos de la épica: es scope de
# PLAT-E26). El docker-compose raíz de mercado-cercano reusa DB_USER/DB_PASSWORD para esta
# conexión (no tiene PAYMENT_METHOD_DB_USER propio) — por eso el runtime real sigue
# conectando acá como ${POSTGRES_USER:-postgres} hasta que E26 le dé su propio rol de
# aplicación; flipear DB_USER a sales_app en el compose raíz ahora rompería esta conexión.
PAYMENT_METHOD_DB_NAME=payment_method_db

# EventBus Configuration — mismo diferimiento que payment_method_db (sin rol propio todavía)
EVENTBUS_DB_HOST=localhost
EVENTBUS_DB_PORT=5432
EVENTBUS_DB_NAME=eventbus

# Auth: TenantValidation de go-shared valida la firma del JWT emitido por IAM y rechaza
# (403) un token sin claim tenant_id — RejectMissingTenant: true ya wireado en main.go.
JWT_SECRET=dev-secret-key-change-me-in-production-min-32-chars

# Namespace (multi-tenant bridge)
SERVICE_NAMESPACE=mc

# Observability
PROMETHEUS_ENABLED=true

# Integraciones
KONG_INTERNAL_URL=http://lab-kong:8000
PIM_SERVICE_PATH=/api/pim-service
STOCK_SERVICE_PATH=/stock
S2S_API_KEY=s2s-internal
