# Dockerfile para build con context desde raíz del monorepo (eventbus)
FROM golang:1.25-bookworm AS deps
WORKDIR /app

# Copiar eventbus primero (replace en go.mod), luego go.mod
COPY libs/eventbus /libs/eventbus
COPY services/sales-service/go.mod services/sales-service/go.sum ./
RUN go mod download && go mod verify

FROM deps AS builder
COPY services/sales-service/ ./
COPY libs/eventbus /libs/eventbus
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags='-w -s' -o sales-service .

FROM golang:1.25-bookworm AS development
RUN groupadd --gid 1001 appgroup && useradd --uid 1001 --gid appgroup --create-home --home-dir /app --shell /bin/sh appuser
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata curl postgresql-client git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY services/sales-service/go.mod services/sales-service/go.sum ./
COPY libs/eventbus /libs/eventbus
RUN go mod download

COPY services/sales-service/ ./
RUN chown -R appuser:appgroup /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1
EXPOSE 8080
CMD ["go", "run", "."]
